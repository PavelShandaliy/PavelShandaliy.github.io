# Public URL of the Google Apps Script Web app, deployed for Anyone, execute as Me.
# Use /exec, not /dev. This is a public address, NOT a token or password.
# See apps-script/README.md for setup.
# VITE_RSVP_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Without an endpoint: npm run dev uses localStorage demo mode.
# Production never uses localStorage; sending is disabled until configured.
